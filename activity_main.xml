<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_dark"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🚴 SHIPPER TRACKER"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_total_odometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tổng: 0.0 km"
            android:textColor="@color/accent_blue"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Navigation Tabs Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/card_dark"
        android:padding="6dp">

        <Button
            android:id="@+id/btn_tab_tracker"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ca Chạy"
            android:textColor="@color/accent_blue"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_tab_history"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="Theo Ngày (Nhiều Ca)"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_tab_fuel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Đổ Xăng"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Frame Content Views -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TAB 1: CA CHẠY HIỆN TẠI -->
        <ScrollView
            android:id="@+id/view_tracker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Odometer Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="24dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_shift_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHƯA CÓ CA NÀO ĐANG CHẠY"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_shift_km"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textColor="@color/accent_blue"
                        android:textSize="56sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KILOMÉT"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="20dp"
                        android:paddingTop="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Thời gian ca"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/tv_shift_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00:00:00"
                                android:textColor="@color/text_main"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vận tốc GPS"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/tv_shift_speed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 km/h"
                                android:textColor="@color/accent_orange"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Start Button (Khi chưa chạy) -->
                <Button
                    android:id="@+id/btn_start_shift"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="20dp"
                    android:text="▶ BẮT ĐẦU CA MỚI"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/accent_green" />

                <!-- Running Controls (Khi đang chạy) -->
                <LinearLayout
                    android:id="@+id/layout_running_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btn_pause_shift"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="⏸ Tạm dừng"
                        android:backgroundTint="@color/card_border"
                        android:textColor="@color/text_main" />

                    <Button
                        android:id="@+id/btn_stop_shift"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1.2"
                        android:text="⏹ KẾT THÚC CA"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/accent_red" />
                </LinearLayout>

                <!-- Quick Refill Button -->
                <Button
                    android:id="@+id/btn_quick_refill"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:text="⛽ GHI NHẬN ĐỔ XĂNG (+ XĂNG)"
                    android:backgroundTint="@color/accent_blue" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="ℹ️ Lưu ý Android 15: Khi bấm 'Bắt đầu ca', GPS chạy ngầm ổn định. Khi bấm 'Kết thúc ca', GPS tắt 100% không tốn pin."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:gravity="center" />
            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: LỊCH SỬ THEO NGÀY (CHIA RÕ TỪNG CA) -->
        <LinearLayout
            android:id="@+id/view_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lịch sử các ngày chạy (Chạm vào ngày để xem từng ca)"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <ListView
                android:id="@+id/list_daily_history"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="10dp" />
        </LinearLayout>

        <!-- TAB 3: LỊCH SỬ ĐỔ XĂNG -->
        <LinearLayout
            android:id="@+id/view_fuel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lịch sử các lần đổ xăng & Chi phí/km"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <ListView
                android:id="@+id/list_fuel_history"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="10dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
