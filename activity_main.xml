<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/bg_dark">

    <!-- Top Safe App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_dark"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🚴 SHIPPER TRACKER"
            android:textColor="@color/text_main"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_total_odometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Odo tổng: 0.0 km"
            android:textColor="@color/accent_blue"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Navigation Tabs Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/card_dark"
        android:padding="6dp">

        <Button
            android:id="@+id/btn_tab_tracker"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CA CHẠY"
            android:textColor="@color/accent_blue"
            android:textStyle="bold"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_tab_history"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="LỊCH SỬ"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_tab_fuel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ĐỔ XĂNG"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Frame Content Views -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TAB 1: CA CHẠY HIỆN TẠI & TỔNG HÔM NAY (CĂN GIỮA TO RÕ RÀNG) -->
        <ScrollView
            android:id="@+id/view_tracker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">

                <!-- KHỐI TRUNG TÂM: TỔNG KM VÀ TỔNG THỜI GIAN HOẠT ĐỘNG HÔM NAY -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="22dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_today_date_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HÔM NAY (LŨY KẾ)"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- TỔNG KM HÔM NAY TO RÕ CHÍNH GIỮA -->
                    <TextView
                        android:id="@+id/tv_today_total_km"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textColor="@color/accent_blue"
                        android:textSize="64sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TỔNG KILOMÉT HÔM NAY"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- TỔNG THỜI GIAN HOẠT ĐỘNG HÔM NAY (ĐẾM ĐẾN TẬN GIÂY) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:background="#12171F"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tổng giờ chạy hôm nay"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/tv_today_total_duration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00:00:00"
                                android:textColor="@color/accent_orange"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/card_border" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Số ca hoàn thành"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/tv_today_shift_completed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 ca"
                                android:textColor="@color/text_main"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- KHUNG CA HIỆN TẠI KHI ĐANG BẬT GPS -->
                <LinearLayout
                    android:id="@+id/card_active_shift"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_active_shift_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● ĐANG BẬT GPS: Ca 1"
                        android:textColor="@color/accent_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/tv_shift_km"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ca: 0.00 km"
                            android:textColor="@color/text_main"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_shift_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00:00"
                            android:textColor="@color/accent_orange"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Start Button (Khi chưa chạy - 1 CHẠM ĂN NGAY) -->
                <Button
                    android:id="@+id/btn_start_shift"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="16dp"
                    android:text="▶ BẮT ĐẦU CA MỚI"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/accent_green" />

                <!-- Running Controls (Khi đang chạy - 1 CHẠM ĂN NGAY) -->
                <LinearLayout
                    android:id="@+id/layout_running_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btn_pause_shift"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="⏸ TẠM DỪNG"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/card_border"
                        android:textColor="@color/text_main" />

                    <Button
                        android:id="@+id/btn_stop_shift"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1.2"
                        android:text="⏹ KẾT THÚC CA"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/accent_red" />
                </LinearLayout>

                <!-- Quick Refill Button -->
                <Button
                    android:id="@+id/btn_quick_refill"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:text="⛽ GHI NHẬN ĐỔ XĂNG (+ XĂNG)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/accent_blue" />

            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: LỊCH SỬ THEO NGÀY (DÒNG CHẢY TRONG APP, KHÔNG POPUP TRẮNG) -->
        <LinearLayout
            android:id="@+id/view_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lịch sử các ngày chạy"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_clear_all_history"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🗑️ Xóa tất cả"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Danh sách dạng dòng chảy Accordion trực tiếp trong app -->
            <ListView
                android:id="@+id/list_daily_history"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp" />
        </LinearLayout>

        <!-- TAB 3: LỊCH SỬ ĐỔ XĂNG -->
        <LinearLayout
            android:id="@+id/view_fuel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lịch sử các lần đổ xăng và Chi phí/km"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <ListView
                android:id="@+id/list_fuel_history"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="10dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
