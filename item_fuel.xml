<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/fuel_datetime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2026-10-02 08:30"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/fuel_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50.000 đ"
            android:textColor="@color/accent_orange"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">
        <TextView
            android:id="@+id/fuel_stats_km"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chạy được: 145.2 km"
            android:textColor="@color/text_main"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/fuel_cost_km"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="~ 344 đ/km"
            android:textColor="@color/accent_green"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
